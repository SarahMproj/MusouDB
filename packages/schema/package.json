{
  "name": "@musoudb/schema",
  "version": "0.0.0",
  "private": true,
  "description": "JSON Schema definitions and data validator for MusouDB v0.",
  "license": "MIT",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "index.mjs",
    "schemas",
    "bin"
  ],
  "bin": {
    "musoudb-validate": "bin/validate.mjs"
  },
  "scripts": {
    "test": "node bin/validate.mjs",
    "validate": "node bin/validate.mjs",
    "validate:examples": "node bin/validate.mjs ../../data/examples"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
