{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.musoudb.org/v0/common.schema.json",
  "title": "MusouDB Common Definitions",
  "description": "Shared definitions reused by every MusouDB v0 entity schema.",
  "$defs": {
    "GameId": {
      "type": "string",
      "pattern": "^game:[a-z0-9][a-z0-9-]*$",
      "description": "Stable MusouDB identifier. See docs/ID_CONVENTIONS.md."
    },
    "CharacterId": {
      "type": "string",
      "pattern": "^character:[a-z0-9][a-z0-9-]*$",
      "description": "Stable MusouDB identifier. See docs/ID_CONVENTIONS.md."
    },
    "FactionId": {
      "type": "string",
      "pattern": "^faction:[a-z0-9][a-z0-9-]*$",
      "description": "Stable MusouDB identifier. See docs/ID_CONVENTIONS.md."
    },
    "WeaponId": {
      "type": "string",
      "pattern": "^weapon:[a-z0-9][a-z0-9-]*$",
      "description": "Stable MusouDB identifier. See docs/ID_CONVENTIONS.md."
    },
    "BattlefieldId": {
      "type": "string",
      "pattern": "^battlefield:[a-z0-9][a-z0-9-]*$",
      "description": "Stable MusouDB identifier. See docs/ID_CONVENTIONS.md."
    },
    "SeriesId": {
      "type": "string",
      "pattern": "^series:[a-z0-9][a-z0-9-]*$",
      "description": "Stable MusouDB identifier. See docs/ID_CONVENTIONS.md."
    },
    "CircleId": {
      "type": "string",
      "pattern": "^circle:[a-z0-9][a-z0-9-]*$",
      "description": "Stable MusouDB identifier. See docs/ID_CONVENTIONS.md."
    },
    "RallyId": {
      "type": "string",
      "pattern": "^rally:[a-z0-9][a-z0-9-]*$",
      "description": "Stable MusouDB identifier. See docs/ID_CONVENTIONS.md."
    },
    "CollectionEntryId": {
      "type": "string",
      "pattern": "^collection:[a-z0-9][a-z0-9-]*$",
      "description": "Stable MusouDB identifier. See docs/ID_CONVENTIONS.md."
    },
    "FriendshipId": {
      "type": "string",
      "pattern": "^friendship:[a-z0-9][a-z0-9-]*$",
      "description": "Stable MusouDB identifier. See docs/ID_CONVENTIONS.md."
    },
    "EntityId": {
      "type": "string",
      "pattern": "^(series|game|character|faction|weapon|battlefield):[a-z0-9][a-z0-9-]*$",
      "description": "Any catalog entity identifier."
    },
    "EntityType": {
      "type": "string",
      "enum": [
        "series",
        "game",
        "character",
        "faction",
        "weapon",
        "battlefield"
      ]
    },
    "UserHandle": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]{2,29}$",
      "description": "Lowercase MusouDB username. Never a legal name."
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "LanguageTag": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "description": "BCP 47 language tag for community-authored text."
    },
    "Platform": {
      "type": "string",
      "description": "Platform family identifier.",
      "enum": [
        "pc",
        "playstation",
        "xbox",
        "nintendo",
        "mobile",
        "arcade",
        "other"
      ]
    },
    "ReleaseYear": {
      "type": "integer",
      "minimum": 1980,
      "maximum": 2100
    },
    "Visibility": {
      "type": "string",
      "enum": [
        "public",
        "friends_only",
        "invite_only",
        "private"
      ],
      "description": "Who may see a record. Defaults are defined per field, not globally."
    },
    "RegionLabel": {
      "type": "string",
      "description": "Broad, user-selected region label. Never GPS or a street address.",
      "enum": [
        "africa",
        "asia_east",
        "asia_south",
        "asia_southeast",
        "asia_west",
        "europe_east",
        "europe_west",
        "north_america",
        "oceania",
        "south_america",
        "unspecified"
      ]
    },
    "IanaTimeZone": {
      "type": "string",
      "pattern": "^[A-Za-z]+(?:[_-][A-Za-z]+)*(?:/[A-Za-z]+(?:[_ -][A-Za-z]+)*){1,2}$|^UTC$",
      "description": "IANA time-zone name, e.g. America/New_York."
    },
    "ProvenanceCategory": {
      "type": "string",
      "enum": [
        "community_observation",
        "official_public_source",
        "public_domain_history",
        "contributor_original"
      ],
      "description": "Provenance vocabulary from docs/IP_AND_ASSET_POLICY.md."
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "citation"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "official_page",
            "in_game_observation",
            "manual",
            "interview",
            "historical_text",
            "community_testing",
            "other"
          ]
        },
        "citation": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500,
          "description": "Human-readable citation. Do not paste copyrighted text."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Link to a public source. Link, never rehost."
        },
        "retrieved_at": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "note": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "Provenance": {
      "type": "object",
      "description": "Required on every catalog record so any claim can be traced.",
      "additionalProperties": false,
      "required": [
        "category"
      ],
      "properties": {
        "category": {
          "$ref": "common.schema.json#/$defs/ProvenanceCategory"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Source"
          }
        },
        "contributor": {
          "$ref": "common.schema.json#/$defs/UserHandle"
        },
        "contributed_at": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "reviewed_by": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/UserHandle"
          }
        },
        "note": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "allOf": [
        {
          "$comment": "Claims attributed to an external source must actually cite one.",
          "if": {
            "type": "object",
            "properties": {
              "category": {
                "enum": [
                  "official_public_source",
                  "public_domain_history"
                ]
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "sources"
            ],
            "properties": {
              "sources": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "SpoilerLevel": {
      "type": "string",
      "enum": [
        "none",
        "minor",
        "major",
        "ending"
      ],
      "description": "none is always safe to render before a reader opts in."
    },
    "SpoilerBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spoiler_level",
        "text"
      ],
      "properties": {
        "spoiler_level": {
          "$ref": "common.schema.json#/$defs/SpoilerLevel"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "Contributor-authored prose only. Never copied wiki or guide text."
        },
        "language": {
          "$ref": "common.schema.json#/$defs/LanguageTag",
          "default": "en"
        },
        "scope_game_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/GameId"
          },
          "description": "Games this block spoils, so it can be hidden per player progress."
        }
      }
    },
    "SpoileredText": {
      "type": "object",
      "description": "Layered text. Readers see spoiler_level 'none' until they opt in.",
      "additionalProperties": false,
      "required": [
        "blocks"
      ],
      "properties": {
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/SpoilerBlock"
          },
          "contains": {
            "type": "object",
            "properties": {
              "spoiler_level": {
                "const": "none"
              }
            },
            "required": [
              "spoiler_level"
            ]
          },
          "$comment": "At least one spoiler-free block is required."
        }
      }
    },
    "Appearance": {
      "type": "object",
      "description": "One entity showing up in one game.",
      "additionalProperties": false,
      "required": [
        "game_id",
        "role"
      ],
      "properties": {
        "game_id": {
          "$ref": "common.schema.json#/$defs/GameId"
        },
        "role": {
          "type": "string",
          "enum": [
            "playable",
            "playable_unlockable",
            "npc_officer",
            "story_only",
            "mentioned",
            "guest",
            "dlc",
            "removed"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/Provenance"
        }
      }
    },
    "ExternalLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url"
      ],
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 80
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "Tag": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
    },
    "RecordMeta": {
      "type": "object",
      "description": "Versioning envelope shared by catalog records.",
      "additionalProperties": false,
      "required": [
        "schema_version"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "accepted",
            "disputed",
            "deprecated"
          ],
          "default": "draft"
        },
        "deprecated_by": {
          "$ref": "common.schema.json#/$defs/EntityId"
        }
      }
    },
    "ForbiddenPersonalFields": {
      "$comment": "Reusable privacy guard. Applied to every user-facing schema so that adding one of these fields is a validation failure, not a code-review oversight.",
      "type": "object",
      "propertyNames": {
        "not": {
          "enum": [
            "legal_name",
            "real_name",
            "full_name",
            "date_of_birth",
            "dob",
            "age",
            "street_address",
            "postal_code",
            "latitude",
            "longitude",
            "gps",
            "precise_location",
            "phone_number",
            "government_id",
            "payment_method",
            "ip_address"
          ]
        }
      }
    },
    "AssetReference": {
      "type": "object",
      "description": "Original or properly licensed community artwork only. Never extracted game assets.",
      "additionalProperties": false,
      "required": [
        "url",
        "license",
        "credit"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "license": {
          "type": "string",
          "enum": [
            "cc0-1.0",
            "cc-by-4.0",
            "cc-by-sa-4.0",
            "contributor-original-granted",
            "public-domain",
            "documented-permission"
          ],
          "$comment": "Enumerated on purpose. Unlicensed or publisher-owned art cannot validate."
        },
        "credit": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "alt_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "permission_note": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  }
}
