{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.musoudb.org/v0/battlefield.schema.json",
  "title": "Battlefield",
  "description": "A stage, battle, or map instance in a game.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "display_name",
    "provenance",
    "meta",
    "game_id",
    "mode"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/BattlefieldId"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Factual reference to a title or name. Community-authored."
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "description": "Alternate romanizations, regional titles, or common fan shorthand."
    },
    "sort_name": {
      "type": "string",
      "maxLength": 200
    },
    "summary": {
      "$ref": "common.schema.json#/$defs/SpoileredText"
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Tag"
      },
      "uniqueItems": true
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/Provenance"
    },
    "meta": {
      "$ref": "common.schema.json#/$defs/RecordMeta"
    },
    "external_links": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ExternalLink"
      }
    },
    "images": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/AssetReference"
      }
    },
    "game_id": {
      "$ref": "common.schema.json#/$defs/GameId"
    },
    "canonical_battle_slug": {
      "$ref": "common.schema.json#/$defs/Slug"
    },
    "canonical_battle_name": {
      "type": "string",
      "maxLength": 200,
      "description": "Series-agnostic battle name used to link recurrences."
    },
    "historical_year": {
      "type": "integer",
      "minimum": -400,
      "maximum": 400
    },
    "mode": {
      "type": "string",
      "enum": [
        "story",
        "free",
        "musou",
        "conquest",
        "empires",
        "gauntlet",
        "side_mission",
        "other"
      ]
    },
    "route": {
      "type": "string",
      "maxLength": 120,
      "description": "Branch or path label where a game supports divergent routes."
    },
    "playable_faction_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/FactionId"
      },
      "uniqueItems": true
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "description"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "primary",
              "secondary",
              "hidden",
              "failure"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 3,
            "maxLength": 600
          },
          "spoiler_level": {
            "$ref": "common.schema.json#/$defs/SpoilerLevel"
          }
        }
      }
    },
    "recurrence_of": {
      "$ref": "common.schema.json#/$defs/BattlefieldId",
      "description": "Earlier battlefield record this one re-stages."
    },
    "appearances": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Appearance"
      }
    }
  }
}
