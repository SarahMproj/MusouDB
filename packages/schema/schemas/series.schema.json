{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.musoudb.org/v0/series.schema.json",
  "title": "Series",
  "description": "A sub-series within the wider Musou family.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "display_name",
    "provenance",
    "meta",
    "family"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/SeriesId"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Factual reference to a title or name. Community-authored."
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "description": "Alternate romanizations, regional titles, or common fan shorthand."
    },
    "sort_name": {
      "type": "string",
      "maxLength": 200
    },
    "summary": {
      "$ref": "common.schema.json#/$defs/SpoileredText"
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Tag"
      },
      "uniqueItems": true
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/Provenance"
    },
    "meta": {
      "$ref": "common.schema.json#/$defs/RecordMeta"
    },
    "external_links": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ExternalLink"
      }
    },
    "images": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/AssetReference"
      }
    },
    "family": {
      "type": "string",
      "enum": [
        "warriors",
        "crossover",
        "collaboration",
        "spinoff",
        "other"
      ]
    },
    "first_release_year": {
      "$ref": "common.schema.json#/$defs/ReleaseYear"
    },
    "game_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/GameId"
      },
      "uniqueItems": true
    }
  }
}
