{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.musoudb.org/v0/game.schema.json",
  "title": "Game",
  "description": "A single released title.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "display_name",
    "provenance",
    "meta",
    "platforms"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/GameId"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Factual reference to a title or name. Community-authored."
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "description": "Alternate romanizations, regional titles, or common fan shorthand."
    },
    "sort_name": {
      "type": "string",
      "maxLength": 200
    },
    "summary": {
      "$ref": "common.schema.json#/$defs/SpoileredText"
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Tag"
      },
      "uniqueItems": true
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/Provenance"
    },
    "meta": {
      "$ref": "common.schema.json#/$defs/RecordMeta"
    },
    "external_links": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ExternalLink"
      }
    },
    "images": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/AssetReference"
      }
    },
    "series_id": {
      "$ref": "common.schema.json#/$defs/SeriesId"
    },
    "release_year": {
      "$ref": "common.schema.json#/$defs/ReleaseYear"
    },
    "regional_titles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "region",
          "title"
        ],
        "properties": {
          "region": {
            "type": "string",
            "enum": [
              "jp",
              "na",
              "eu",
              "asia",
              "global"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Platform"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "player_modes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "single_player",
          "local_co_op",
          "online_co_op",
          "local_versus",
          "online_versus",
          "asynchronous"
        ]
      }
    },
    "max_local_players": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "max_online_players": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "developer": {
      "type": "string",
      "maxLength": 200,
      "description": "Factual credit reference. Not an endorsement."
    },
    "publisher": {
      "type": "string",
      "maxLength": 200
    },
    "is_expansion_of": {
      "$ref": "common.schema.json#/$defs/GameId"
    },
    "successor_of": {
      "$ref": "common.schema.json#/$defs/GameId"
    },
    "has_character_creation": {
      "type": "boolean"
    },
    "spoiler_sensitive": {
      "type": "boolean",
      "default": true,
      "description": "Whether story text for this game should default to hidden."
    }
  }
}
